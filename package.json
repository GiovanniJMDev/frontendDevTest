{
  "name": "frontend-dev-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sonar:start": "docker compose up -d",
    "sonar:stop": "docker compose down",
    "sonar": "sonar-scanner -Dproject.settings=sonar.properties"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "oxlint": "1.81.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.2"
  }
